# Copy to .env.local. EXPO_PUBLIC_* values are bundled into the app,
# so only ever put the anon (public) key here, never the service_role key.
#
# Local Supabase (docker): run `npm run db:start`, then copy API_URL and ANON_KEY
# from `npm run db:status -- -o env`. The iOS simulator can reach 127.0.0.1, and on the Android
# emulator src/lib/supabase.ts rewrites 127.0.0.1 to 10.0.2.2 for you.
# A physical phone needs your Mac's LAN IP instead (e.g. http://192.168.1.20:54321).
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# RevenueCat public SDK key (safe to bundle). A `test_` key uses the Test Store; use the `appl_` / `goog_` keys for real
# store builds. Needs a rebuilt dev app (npx expo run:ios / run:android): the SDK is native.
EXPO_PUBLIC_REVENUECAT_API_KEY=
# Store builds: one real key per store instead (set them as EAS environment variables, see docs/release.md).
# EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_...
# EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_...
